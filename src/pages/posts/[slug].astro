---
// 文章详情页 - 动态路由，根据 slug 显示单篇文章
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// 预生成所有可能的路由路径（静态生成）
export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  return blogPosts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

// 从 props 中获取文章数据
const { post } = Astro.props;
// 渲染文章内容
const { Content } = await post.render();
---

<BaseLayout pageTitle={post.data.title}>
  <!-- 文章元信息区域 -->
  <div class="mb-6">
    <!-- 发布日期 -->
    <p class="text-slate-500 dark:text-slate-400 mb-2 flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-purple-500"></span>
      {post.data.pubDate.toDateString()}
    </p>
    <!-- 文章描述 -->
    <p class="text-lg italic text-slate-600 dark:text-slate-300 mb-4">
      {post.data.description}
    </p>
    <!-- 作者 -->
    <p class="text-slate-700 dark:text-slate-300 font-medium">
      Written by: <span class="text-purple-600 dark:text-purple-400">{post.data.author}</span>
    </p>
  </div>

  <!-- 文章图片（如果有） -->
  {post.data.image && (
    <div class="mb-8">
      <img
        src={post.data.image.url}
        width="600"
        alt={post.data.image.alt}
        class="w-full rounded-2xl shadow-2xl border-4 border-white/50 dark:border-slate-700/50"
      />
    </div>
  )}

  <!-- 标签列表（如果有） -->
  {post.data.tags && (
    <div class="flex flex-wrap gap-2 mb-8">
      {post.data.tags.map(tag => (
        <a
          href={`/tags/${tag}`}
          class="px-4 py-2 bg-gradient-to-r from-purple-100 to-pink-100 dark:from-purple-900/40 dark:to-pink-900/40 text-purple-700 dark:text-purple-300 rounded-full text-sm font-semibold hover:shadow-md transition-all duration-300 border border-purple-200 dark:border-purple-800/50"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}

  <!-- 文章内容区域，使用 Tailwind Typography 插件美化 -->
  <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:bg-gradient-to-r prose-headings:from-purple-600 prose-headings:to-pink-600 prose-headings:bg-clip-text prose-headings:text-transparent">
    <Content />
  </article>
</BaseLayout>
