---
// 标签详情页 - 显示指定标签下的所有文章
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';

// 预生成所有标签的路由路径
export async function getStaticPaths() {
  const allPosts = await getCollection('blog');

  // 提取所有不重复的标签
  const uniqueTags = [
    ...new Set(allPosts.map(post => post.data.tags).filter(Boolean).flat()),
  ];

  // 为每个标签生成路由，同时过滤出该标签下的文章
  return uniqueTags.map(tag => {
    const filteredPosts = allPosts.filter(
      post => post.data.tags && post.data.tags.includes(tag)
    );
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

// 获取当前标签
const { tag } = Astro.params;
// 获取该标签下的文章列表
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag}>
  <!-- 标签标题和描述 -->
  <div class="mb-8">
    <span class="inline-block px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-full text-sm font-bold mb-4">
      #{tag}
    </span>
    <p class="text-lg text-slate-600 dark:text-slate-400">
      包含「{tag}」标签的文章 ({posts.length} 篇)
    </p>
  </div>
  <!-- 文章列表 -->
  <div class="space-y-4">
    {posts.map(post => (
      <!-- 文章卡片 -->
      <a
        href={`/posts/${post.slug}`}
        class="block p-6 rounded-2xl bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/30 dark:to-purple-900/30 border border-blue-100 dark:border-blue-800/50 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 group"
      >
        <h3 class="text-xl font-bold text-slate-800 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-300 transition-colors">
          {post.data.title}
        </h3>
        <p class="text-slate-600 dark:text-slate-400 mt-2">{post.data.description}</p>
        <div class="mt-4 text-sm text-slate-500 dark:text-slate-500">
          {post.data.pubDate.toDateString()}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
